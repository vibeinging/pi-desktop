#The defined variable must start with VITE_APP_ (proxy 变量除外)
# 浏览器开发调试通过 Vite proxy 访问本地后端

VITE_APP_ENV = 'dev'
VITE_APP_DEV_PORT = '52731'

# 留空 → axios baseURL 取 window.location.origin(localhost:52731),请求走同源,由下面的 proxy 转发
VITE_APP_BASE_URL = ''

# 仅浏览器 + Vite proxy 联调使用：需要与后端 PI_HTTP_TOKEN 保持一致，勿提交真实令牌。
VITE_PI_HTTP_TOKEN = ''

# dev proxy:把 /api 前缀的请求转发到本地后端(端口 52838)
# 后端路由本身带 /api 前缀,故不 strip;若某后端不带前缀,加 VITE_PROXY_STRIP = '1'
VITE_PROXY_BASE_URL = '/api'
VITE_PROXY_URL = 'http://127.0.0.1:52838'
