{
  "name": "yiw-desktop",
  "private": true,
  "version": "0.0.1",
  "productName": "YiW",
  "main": "electron/main.js",
  "engines": {
    "node": ">=26.3.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "setup": "node scripts/native-npm.mjs --prefix server ci && node scripts/native-npm.mjs --prefix renderer ci && node scripts/native-npm.mjs --prefix electron ci && npm run build:server-pi",
    "dev": "node scripts/dev.mjs",
    "build:icons": "electron/node_modules/.bin/electron scripts/generate-icons.cjs",
    "dev:renderer": "node scripts/native-npm.mjs --prefix renderer run dev -- --host 127.0.0.1",
    "dev:electron": "node scripts/native-npm.mjs --prefix electron run dev",
    "typecheck": "node scripts/native-npm.mjs --prefix renderer run typecheck",
    "test:renderer": "node scripts/native-npm.mjs --prefix renderer test",
    "test:server": "node --test server/src/engine/modules/miniapp_compiler.test.js server/src/engine/modules/module_registry.test.js server/src/engine/modules/module_validator.test.js server/src/engine/modules/skill_product.test.js server/src/engine/agents/product_tool_catalog.ui_modules.test.js server/src/engine/datasources/unstructured/document_loaders.test.js",
    "ensure:server-pi": "node scripts/native-npm.mjs --prefix server run ensure:pi",
    "build:renderer": "npm run ensure:server-pi && node scripts/native-npm.mjs --prefix renderer run build:desktop",
    "build:server-pi": "node scripts/native-npm.mjs --prefix server run build:pi",
    "check": "npm run typecheck && npm run test:renderer && npm run test:server && npm run build:renderer"
  }
}
