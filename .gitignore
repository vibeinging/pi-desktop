# 依赖(各级 node_modules)
**/node_modules/

# 前端构建产物
renderer/dist/
renderer/.vite/

# Electron 打包产物
release/

# 本地数据库 / 日志 / 临时
*.log
*.db
*.db-wal
*.db-shm
!eval/datasets/functional/input/task_多轮对话/context/db/trade_dist.sqlite
.DS_Store

# app/eval 运行输出
eval/results/

# vendored pi 的编译产物(build:pi 可再生,不入库)
server/vendor/pi/**/dist/

# 本地环境和凭据
.env
.env.*
!.env.example
!**/.env.example

# 可选的本地向量扩展二进制（公开仓库不分发）
server/vendor/vexdb_lite/**/*.dylib
server/vendor/vexdb_lite/**/*.dll
